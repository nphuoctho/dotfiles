# Maple Mono has ligatures, on by default
font-family = "Maple Mono NF"
font-size = 13

# No titlebar
window-decoration = none
gtk-titlebar = false

background-opacity = 0.95
background-blur = true

window-padding-x = 8
window-padding-y = 8

mouse-hide-while-typing = true
# No size popup on i3 resizes
resize-overlay = never

# Share one process across windows
gtk-single-instance = true

# Keep terminfo working through sudo and ssh
shell-integration-features = cursor,title,path,sudo,ssh-env,ssh-terminfo

# Beam cursor, no blink
cursor-style = bar
cursor-style-blink = false

# Copy on select to the clipboard
copy-on-select = clipboard

theme = TokyoNight Night

# Keybinds, same as alacritty
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+l=toggle_maximize
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
# Shift+Enter sends an escaped newline
keybind = shift+enter=text:\x1b\r
